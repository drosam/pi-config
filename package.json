{
  "name": "pi-config",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:vitest && npm run test:node && npm run test:web-tools",
    "test:vitest": "vitest run extensions/subagent extensions/question",
    "test:node": "node --import tsx --test extensions/btw/*.test.ts extensions/compact-min/*.test.ts extensions/herdr-permissions/*.test.ts",
    "test:web-tools": "npm test --prefix extensions/web-tools"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "npm:@earendil-works/pi-ai@1.5.2",
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@1.5.2",
    "@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@1.5.2",
    "@sinclair/typebox": "npm:typebox@1.3.27",
    "tsx": "^4.23.15",
    "typebox": "1.3.27",
    "vitest": "^5.1.0"
  }
}
